# Copia este archivo como .env.local y completa solo lo que uses. No subas .env.local ni escribas claves reales aquí.
# Todas las variables son opcionales: sin ellas la app corre con datos simulados y un asesor IA simulado.
NEXT_PUBLIC_APP_NAME="Eight Academy"

# Supabase (servidor). Si ambas están definidas se usa Supabase en vez de los datos simulados.
# Supabase está retirando las claves anon y service_role. Sin cambiar los nombres de las variables:
#   SUPABASE_SERVICE_ROLE_KEY     -> Secret key (sb_secret_...), solo servidor
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (Supabase Auth para familias es una fase futura: sus variables públicas se agregarán entonces.)

# Claude (Anthropic). Si está definida, el asesor y el auditor usan IA real.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Acceso al panel administrativo.
# Desarrollo: si no se define se usa "admin-demo".
# Producción: OBLIGATORIAS. ADMIN_PASSCODE ≥ 16 caracteres y SESSION_SECRET ≥ 32 caracteres; si faltan, el panel queda cerrado.
# Generar: openssl rand -base64 24  /  openssl rand -base64 48
ADMIN_PASSCODE=
SESSION_SECRET=

# n8n. Sin N8N_WEBHOOK_SECRET el webhook entrante responde 401 en todos los entornos.
N8N_WEBHOOK_SECRET=
N8N_OUTBOUND_WEBHOOK_URL=
# URL pública de la app para los enlaces de los correos (p. ej. https://mi-app.vercel.app). Si falta, se usa el origen de la petición.
APP_URL=

# Opcional: fecha de inicio del reloj de la app (ISO, p. ej. 2026-01-31). Sin Supabase, por defecto se usa la
# fecha de corte del dataset ficticio (31 ene 2026) para que los estados de pensiones coincidan con los CSV.
# Con Supabase y la demo del dataset: defínela (2026-01-31T15:00:00Z); las escrituras usan esa fecha (migración demo_clock).
DEMO_TODAY=

# Solo para cargar migraciones y seed desde la terminal (no lo usa la app): Supabase → Connect → Session pooler.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
